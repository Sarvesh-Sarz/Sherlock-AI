# Copy this file to .env and adjust as needed.
# All variables are prefixed with SHERLOCK_ (see app/core/config.py).

SHERLOCK_ENVIRONMENT=development
SHERLOCK_APP_NAME=Sherlock AI Backend

# JSON-style list of allowed CORS origins for the frontend dev server.
SHERLOCK_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional. Enables real internet research via Tavily (https://tavily.com).
# Leave unset to run with research disabled — Sherlock degrades
# gracefully and reports use local evidence only (see
# app.research.researcher.UnconfiguredResearcher).
# Never commit a real key here — this file only holds a placeholder.
SHERLOCK_TAVILY_API_KEY=

# Local LLM reasoning via Ollama (https://ollama.com). No credentials —
# Sherlock tries this first and falls back to the deterministic
# baseline reasoner automatically if Ollama isn't running, the model
# isn't pulled, or its output can't be parsed (see
# app.reasoning.fallback_reasoner.FallbackReasoner). Nothing to
# configure to run Sherlock; these are the defaults for a locally
# running default Ollama install.
SHERLOCK_OLLAMA_BASE_URL=http://localhost:11434
SHERLOCK_OLLAMA_MODEL=llama3.1
SHERLOCK_OLLAMA_TIMEOUT_SECONDS=15
