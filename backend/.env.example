# Copy this file to .env and adjust as needed.
# All variables are prefixed with SHERLOCK_ (see app/core/config.py).

SHERLOCK_ENVIRONMENT=development
SHERLOCK_APP_NAME=Sherlock AI Backend

# JSON-style list of allowed CORS origins for the frontend dev server.
SHERLOCK_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
